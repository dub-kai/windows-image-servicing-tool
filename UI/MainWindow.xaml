<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win Image Admin (Next)"
        Name="MainWindow"
        Height="760" Width="1120"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="Manual"
        WindowState="Maximized"
        Background="#E8EEF2">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#0F766E"/>
      <Setter Property="BorderBrush" Value="#0F766E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#115E59"/>
                <Setter Property="BorderBrush" Value="#115E59"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#134E4A"/>
                <Setter Property="BorderBrush" Value="#134E4A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D5DEE6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D5DEE6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="#D5DEE6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#F7FAFC"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style TargetType="ListView">
      <Setter Property="BorderBrush" Value="#D5DEE6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="#D5DEE6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#F7FAFC"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#13283B" Padding="16,14">
      <DockPanel LastChildFill="True">

        <Image Name="ImgBanner"
               DockPanel.Dock="Left"
               Height="52"
               Margin="0,0,14,0"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
          <TextBlock Foreground="White" FontSize="21" FontWeight="SemiBold"
                     Text="Win Image Admin (Next)"/>
          <TextBlock Name="TxtMainSubtitle" Foreground="#B7C5D2" FontSize="12"
                     Text="Deployment, Images, Driver und Updates in einer Oberfläche"/>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Nav -->
      <Border Grid.Column="0" Background="#F2F6F9" Padding="14">
        <DockPanel LastChildFill="True">

          <!-- Top nav -->
          <StackPanel DockPanel.Dock="Top">
            <Button Name="BtnDashboard" Height="38" Margin="0,0,0,8" Content="Dashboard"/>
            <Button Name="BtnImages" Height="38" Margin="0,0,0,8" Content="Images"/>
            <Button Name="BtnMedia" Height="38" Margin="0,0,0,8" Content="Media Builder"/>
            <Button Name="BtnDriver" Height="38" Margin="0,0,0,8" Content="Driver"/>
            <Button Name="BtnUpdates" Height="38" Margin="0,0,0,8" Content="Updates"/>
          </StackPanel>

          <!-- Bottom area -->
          <StackPanel DockPanel.Dock="Bottom">
            <Separator Margin="0,10,0,10"/>
            <Button Name="BtnSettings" Height="38" Margin="0,0,0,10" Content="Settings"/>

            <Separator Margin="0,10,0,10"/>

            <TextBlock Name="TxtShellState" Text="Status" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
            <Border Background="White" BorderBrush="#D5DEE6" BorderThickness="1" CornerRadius="12" Padding="12">
              <StackPanel>
                <TextBlock Name="TxtIso" Foreground="#334155" Text="ISO: -" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Name="TxtImage" Foreground="#334155" Text="Image: -" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>

        </DockPanel>
      </Border>

      <!-- Content -->
      <Border Grid.Column="1" Background="#EEF3F6" Padding="18">
        <Frame Name="MainFrame" NavigationUIVisibility="Hidden"/>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Background="#102131" Padding="12,10">
      <DockPanel>
        <TextBlock Name="TxtStatus" Foreground="#E5E7EB" Text="Ready"/>
        <TextBlock Name="TxtBuild" Foreground="#97A7B7" DockPanel.Dock="Right" Text="v0.1"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
