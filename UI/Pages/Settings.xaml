<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="Transparent">

  <Grid Margin="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="24"
               FontWeight="SemiBold"
               Foreground="#0F172A"
               Margin="0,0,0,16"
               Text="Settings" />

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <GroupBox Header="Standardverhalten" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Startseite:"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Name="CmbSettingsStartPage" Height="28" MinWidth="220" SelectedIndex="0" Margin="0,0,0,12">
              <ComboBoxItem Content="Dashboard"/>
              <ComboBoxItem Content="Images"/>
              <ComboBoxItem Content="Driver"/>
              <ComboBoxItem Content="Updates"/>
              <ComboBoxItem Content="Settings"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Driver-Ansicht:"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Name="ChkSettingsDriverLoadAllDefault" Margin="0,0,0,12" Content="Treiber standardmäßig vollständig inkl. Inbox laden"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Updates:"/>
            <CheckBox Grid.Row="2" Grid.Column="1" Name="ChkSettingsUpdatesAutoCatalogDefault" Margin="0,0,0,12" Content="Catalog bei Mount-Wechsel automatisch laden"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Neue Mounts:"/>
            <CheckBox Grid.Row="3" Grid.Column="1" Name="ChkSettingsImageMountReadOnlyDefault" Margin="0,0,0,12" Content="Neue Mounts standardmäßig als ReadOnly anlegen"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" VerticalAlignment="Center" Text="Debug:"/>
            <CheckBox Grid.Row="4" Grid.Column="1" Name="ChkSettingsAppDebug" Content="Erweitertes Debug-Verhalten aktivieren"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="MountRoot (Arbeitsordner für DISM-Mounts)" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Name="TxtSettingsMountRoot"
                         Grid.Column="0"
                         Text="MountRoot: -"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Margin="0,0,10,0"/>

              <Button Name="BtnSettingsPickMountRoot"
                      Grid.Column="1"
                      Content="Ordner wählen"
                      Height="28"
                      MinWidth="130"
                      Margin="0,0,8,0"/>

              <Button Name="BtnSettingsResetMountRoot"
                      Grid.Column="2"
                      Content="Reset"
                      Height="28"
                      MinWidth="90"/>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="#374151"
                       TextWrapping="Wrap"
                       Text="Hinweis: Lokaler NTFS-Pfad empfohlen. Diese Einstellung wird dauerhaft im ignorierten Work-Bereich gespeichert."/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Info" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="ProjectRoot:" Margin="0,0,10,6"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtSettingsProjectRoot" Text="-" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="LogFile:" Margin="0,0,10,6"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtSettingsLogFile" Text="-" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="ConfigFile:" Margin="0,0,10,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtSettingsConfigFile" Text="-" TextWrapping="Wrap"/>
          </Grid>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</Page>
