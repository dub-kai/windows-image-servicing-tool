<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="Transparent">

  <Grid Margin="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Name="TxtSettingsPageTitle" Grid.Row="0"
               FontSize="24"
               FontWeight="SemiBold"
               Foreground="#0F172A"
               Margin="0,0,0,16"
               Text="Settings" />

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <GroupBox Name="GrpSettingsDefaults" Header="Standardverhalten" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Name="TxtSettingsStartPageLabel" Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Startseite:"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Name="CmbSettingsStartPage" Height="28" MinWidth="220" SelectedIndex="0" Margin="0,0,0,12">
              <ComboBoxItem Name="CmbItemStartPageDashboard" Tag="Dashboard" Content="Dashboard"/>
              <ComboBoxItem Name="CmbItemStartPageImages" Tag="Images" Content="Images"/>
              <ComboBoxItem Name="CmbItemStartPageMedia" Tag="Media" Content="Media Builder"/>
              <ComboBoxItem Name="CmbItemStartPageDriver" Tag="Driver" Content="Driver"/>
              <ComboBoxItem Name="CmbItemStartPageUpdates" Tag="Updates" Content="Updates"/>
              <ComboBoxItem Name="CmbItemStartPageSettings" Tag="Settings" Content="Settings"/>
            </ComboBox>

            <TextBlock Name="TxtSettingsLanguageLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Sprache:"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Name="CmbSettingsLanguage" Height="28" MinWidth="220" Margin="0,0,0,12">
              <ComboBoxItem Name="CmbItemLanguageDe" Tag="de" Content="Deutsch"/>
              <ComboBoxItem Name="CmbItemLanguageEn" Tag="en" Content="Englisch"/>
            </ComboBox>

            <TextBlock Name="TxtSettingsDriverViewLabel" Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Driver-Ansicht:"/>
            <CheckBox Grid.Row="2" Grid.Column="1" Name="ChkSettingsDriverLoadAllDefault" Margin="0,0,0,12" Content="Treiber standardmäßig vollständig inkl. Inbox laden"/>

            <TextBlock Name="TxtSettingsUpdatesLabel" Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Updates:"/>
            <CheckBox Grid.Row="3" Grid.Column="1" Name="ChkSettingsUpdatesAutoCatalogDefault" Margin="0,0,0,12" Content="Catalog bei Mount-Wechsel automatisch laden"/>

            <TextBlock Name="TxtSettingsNewMountsLabel" Grid.Row="4" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Neue Mounts:"/>
            <CheckBox Grid.Row="4" Grid.Column="1" Name="ChkSettingsImageMountReadOnlyDefault" Margin="0,0,0,12" Content="Neue Mounts standardmäßig als ReadOnly anlegen"/>

            <TextBlock Name="TxtSettingsNotificationsLabel" Grid.Row="5" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Benachrichtigungen:"/>
            <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,12">
              <CheckBox Name="ChkSettingsNotificationsEnabled" VerticalAlignment="Center" Margin="0,0,12,0" Content="Windows-Benachrichtigungen bei abgeschlossenen Jobs anzeigen"/>
              <Button Name="BtnSettingsTestNotification" MinWidth="170" Height="28" Content="Test-Benachrichtigung"/>
            </WrapPanel>

            <TextBlock Name="TxtSettingsDebugLabel" Grid.Row="6" Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" VerticalAlignment="Center" Text="Debug:"/>
            <CheckBox Grid.Row="6" Grid.Column="1" Name="ChkSettingsAppDebug" Content="Erweitertes Debug-Verhalten aktivieren"/>
          </Grid>
        </GroupBox>

        <GroupBox Name="GrpSettingsAdk" Header="ADK &amp; WinPE" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
              <Button Name="BtnSettingsDetectAdk"
                      Content="ADK erkennen"
                      Height="30"
                      MinWidth="130"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsPickAdkRoot"
                      Content="ADK-Ordner wählen"
                      Height="30"
                      MinWidth="150"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsPickWinPeRoot"
                      Content="WinPE-Ordner wählen"
                      Height="30"
                      MinWidth="160"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsPickOscdimgPath"
                      Content="oscdimg.exe wählen"
                      Height="30"
                      MinWidth="170"
                      Margin="0,0,0,8"/>
            </WrapPanel>

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Name="TxtSettingsAdkSummary"
                       Foreground="#374151"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"
                       Text="ADK-Status: noch nicht geprüft."
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,6" FontWeight="SemiBold" Text="ADK Root:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtSettingsAdkRoot" Margin="0,0,10,6" Text="-" TextWrapping="Wrap"/>
            <Button Grid.Row="2" Grid.Column="2" Name="BtnSettingsResetAdkRoot" Content="Reset" Height="28" MinWidth="90"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,6" FontWeight="SemiBold" Text="WinPE Root:"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtSettingsWinPeRoot" Margin="0,0,10,6" Text="-" TextWrapping="Wrap"/>
            <Button Grid.Row="3" Grid.Column="2" Name="BtnSettingsResetWinPeRoot" Content="Reset" Height="28" MinWidth="90"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,6" FontWeight="SemiBold" Text="oscdimg.exe:"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Name="TxtSettingsOscdimgPath" Margin="0,0,10,6" Text="-" TextWrapping="Wrap"/>
            <Button Grid.Row="4" Grid.Column="2" Name="BtnSettingsResetOscdimgPath" Content="Reset" Height="28" MinWidth="90"/>

            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
              <TextBlock Name="TxtSettingsCopypePath" Margin="0,0,0,6" Foreground="#374151" Text="copype.cmd: -" TextWrapping="Wrap"/>
              <TextBlock Name="TxtSettingsMakeWinPeMediaPath" Foreground="#374151" Text="MakeWinPEMedia.cmd: -" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Name="GrpSettingsHealth" Header="Maintenance &amp; Health" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
              <Button Name="BtnSettingsHealthRefresh"
                      Content="Status aktualisieren"
                      Height="30"
                      MinWidth="150"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsUnmountAllDiscard"
                      Content="Alle Mounts unmounten (Discard)"
                      Height="30"
                      MinWidth="220"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsCleanupEmptyMountDirs"
                      Content="Leere Mount-Ordner bereinigen"
                      Height="30"
                      MinWidth="210"
                      Margin="0,0,0,8"/>
            </WrapPanel>

            <TextBlock Grid.Row="1"
                       Name="TxtSettingsHealthSummary"
                       Foreground="#374151"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Text="Status: noch nicht geladen."
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="2" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,6" Text="Admin:"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtSettingsHealthAdmin" Margin="0,0,0,6" Text="-" TextWrapping="Wrap"/>

              <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,6" Text="DISM:"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtSettingsHealthDism" Margin="0,0,0,6" Text="-" TextWrapping="Wrap"/>

              <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,6" Text="MountRoot:"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtSettingsHealthMountRoot" Margin="0,0,0,6" Text="-" TextWrapping="Wrap"/>

              <TextBlock Name="TxtSettingsHealthFreeSpaceLabel" Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,6" Text="Freier Platz:"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtSettingsHealthDrive" Margin="0,0,0,6" Text="-" TextWrapping="Wrap"/>

              <TextBlock Name="TxtSettingsHealthActiveMountsLabel" Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,6" Text="Aktive Mounts:"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Name="TxtSettingsHealthMountCount" Margin="0,0,0,6" Text="-" TextWrapping="Wrap"/>

              <TextBlock Grid.Row="5" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,0" Text="Logdatei:"/>
              <TextBlock Grid.Row="5" Grid.Column="1" Name="TxtSettingsHealthLog" Margin="0,0,0,0" Text="-" TextWrapping="Wrap"/>
            </Grid>

            <Border Grid.Row="3"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Name="TxtSettingsMountedImagesTitle" FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Margin="0,0,0,8"
                           Text="Gemountete Images"/>
                <ListBox Name="LstSettingsHealthMounts"
                         MinHeight="120"
                         BorderThickness="0"
                         Background="Transparent"/>
              </StackPanel>
            </Border>

            <TextBlock Name="TxtSettingsHealthHint" Grid.Row="4"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="Maintenance-Aktionen bleiben bewusst vorsichtig: Unmount nutzt immer Discard, und die Bereinigung entfernt nur leere Unterordner unterhalb des aktiven MountRoot."/>
          </Grid>
        </GroupBox>

        <GroupBox Name="GrpSettingsLogs" Header="Logs" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
              <Button Name="BtnSettingsLogsRefresh"
                      Content="Logs aktualisieren"
                      Height="30"
                      MinWidth="150"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsOpenLogFolder"
                      Content="Log-Ordner öffnen"
                      Height="30"
                      MinWidth="150"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsOpenCurrentLog"
                      Content="Aktuelles App-Log öffnen"
                      Height="30"
                      MinWidth="190"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsOpenDismLog"
                      Content="DISM-Log öffnen"
                      Height="30"
                      MinWidth="140"
                      Margin="0,0,10,8"/>

              <Button Name="BtnSettingsCleanupOldLogs"
                      Content="Alte App-Logs bereinigen"
                      Height="30"
                      MinWidth="190"
                      Margin="0,0,0,8"/>
            </WrapPanel>

            <TextBlock Grid.Row="1"
                       Name="TxtSettingsLogsSummary"
                       Foreground="#374151"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Text="Logs: noch nicht geladen."
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="2" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Name="TxtSettingsAppLogPathLabel" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,6" Text="App-Log:"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtSettingsAppLogPath" Margin="0,0,0,6" Text="-" TextWrapping="Wrap"/>

              <TextBlock Name="TxtSettingsDismLogPathLabel" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,0" Text="DISM-Log:"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtSettingsDismLogPath" Margin="0,0,0,0" Text="-" TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Name="TxtSettingsLogPreviewSourceLabel" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Text="Vorschau:"/>
              <ComboBox Name="CmbSettingsLogPreviewSource" Grid.Column="1" Height="28" SelectedIndex="0">
                <ComboBoxItem Name="CmbItemLogPreviewApp" Tag="App" Content="Aktuelles App-Log"/>
                <ComboBoxItem Name="CmbItemLogPreviewDism" Tag="Dism" Content="DISM-Log"/>
              </ComboBox>
            </Grid>

            <Border Grid.Row="4"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Name="TxtSettingsLogFilesTitle"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Margin="0,0,0,8"
                           Text="App-Logdateien"/>
                <ListBox Name="LstSettingsLogFiles"
                         MinHeight="100"
                         BorderThickness="0"
                         Background="Transparent"/>
              </StackPanel>
            </Border>

            <TextBlock Name="TxtSettingsLogPreviewTitle"
                       Grid.Row="5"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       Margin="0,0,0,8"
                       Text="Log-Vorschau"/>

            <TextBox Name="TxtSettingsLogPreview"
                     Grid.Row="6"
                     MinHeight="190"
                     MaxHeight="320"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="White"
                     BorderBrush="#E5E7EB"
                     Text=""/>

            <TextBlock Name="TxtSettingsLogsHint"
                       Grid.Row="7"
                       Margin="0,10,0,0"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="Die Bereinigung löscht nur alte App-Logs im Projekt-Logordner. Das aktuelle App-Log und DISM-Logs bleiben erhalten."/>
          </Grid>
        </GroupBox>

        <GroupBox Name="GrpSettingsDismBatch" Header="DISM &amp; Batch-Verhalten" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Standard-DISM-Timeout:"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="TxtSettingsDismTimeoutSec" Height="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" Text="Sekunden für normale DISM-Befehle."/>

            <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="DISM-Lock-Timeout:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="TxtSettingsDismLockTimeoutSec" Height="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" Text="Wie lange ein Befehl auf den DISM-Mutex wartet."/>

            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Commit-Timeout:"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="TxtSettingsDismUnmountCommitTimeoutSec" Height="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" Text="Sekunden für Unmount mit Commit. Große WIMs brauchen lange."/>

            <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Commit-Retry-Anzahl:"/>
            <TextBox Grid.Row="3" Grid.Column="1" Name="TxtSettingsDismUnmountCommitRetryCount" Height="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" Text="Wiederholungen bei gesperrter WIM oder Registry-Handles."/>

            <TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Commit-Retry-Pause:"/>
            <TextBox Grid.Row="4" Grid.Column="1" Name="TxtSettingsDismUnmountCommitRetryDelaySec" Height="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Grid.Column="3" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" Text="Sekunden zwischen Commit-Retrys."/>

            <TextBlock Grid.Row="5" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Mount-Refresh-Wartezeit:"/>
            <TextBox Grid.Row="5" Grid.Column="1" Name="TxtSettingsMountedWimRefreshQuietPeriodSec" Height="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Grid.Column="3" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" Text="Kurze Pause nach Mount-Listen-Refresh vor Commit."/>

            <TextBlock Grid.Row="6" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Batch-Unmount-Pause:"/>
            <TextBox Grid.Row="6" Grid.Column="1" Name="TxtSettingsBatchUnmountStepDelaySec" Height="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="6" Grid.Column="3" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" Text="Sekunden Pause zwischen mehreren Commit-Unmounts."/>

            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
              <Button Name="BtnSettingsSaveDismBatch"
                      Content="DISM/Batch speichern"
                      Height="30"
                      MinWidth="170"
                      Margin="0,0,10,0"/>
              <Button Name="BtnSettingsResetDismBatch"
                      Content="Standardwerte"
                      Height="30"
                      MinWidth="130"/>
              <TextBlock Name="TxtSettingsDismBatchHint"
                         Margin="14,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="#64748B"
                         TextWrapping="Wrap"
                         Text="Änderungen gelten für neue DISM-Aufgaben."/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Name="GrpSettingsMountRoot" Header="MountRoot (Arbeitsordner für DISM-Mounts)" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Name="TxtSettingsMountRoot"
                         Grid.Column="0"
                         Text="MountRoot: -"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Margin="0,0,10,0"/>

              <Button Name="BtnSettingsPickMountRoot"
                      Grid.Column="1"
                      Content="Ordner wählen"
                      Height="28"
                      MinWidth="130"
                      Margin="0,0,8,0"/>

              <Button Name="BtnSettingsResetMountRoot"
                      Grid.Column="2"
                      Content="Reset"
                      Height="28"
                      MinWidth="90"/>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="#374151"
                       TextWrapping="Wrap"
                       Text="Hinweis: Lokaler NTFS-Pfad empfohlen. Diese Einstellung wird dauerhaft im ignorierten Work-Bereich gespeichert."/>
          </Grid>
        </GroupBox>

        <GroupBox Name="GrpSettingsInfo" Header="Info" Margin="0,0,0,12">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="ProjectRoot:" Margin="0,0,10,6"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtSettingsProjectRoot" Text="-" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="LogFile:" Margin="0,0,10,6"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtSettingsLogFile" Text="-" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="ConfigFile:" Margin="0,0,10,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtSettingsConfigFile" Text="-" TextWrapping="Wrap"/>
          </Grid>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</Page>
