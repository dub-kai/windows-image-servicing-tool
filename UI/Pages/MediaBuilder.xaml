<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Media Builder"
      Background="Transparent">

  <Grid Margin="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="24"
               FontWeight="SemiBold"
               Foreground="#0F172A"
               Margin="0,0,0,16"
               Text="Media Builder" />

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <Border Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="16" CornerRadius="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,8" Text="1. Neue ISO bauen"/>
            <TextBlock Foreground="#475569" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Die gemountete Windows-ISO ist die Grundlage. Du kannst bei Bedarf ein anderes Install-Image oder eine andere boot.wim einsetzen und daraus eine neue bootfähige ISO bauen."/>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Basis-ISO:"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtMediaSourceIso" Margin="0,0,0,8" Text="-" TextWrapping="Wrap"/>

              <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Install-Image:"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtMediaInstallImage" Margin="0,0,0,8" Text="-" TextWrapping="Wrap"/>

              <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,0" Text="Boot-Image:"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtMediaBootImage" Text="-" TextWrapping="Wrap"/>
            </Grid>

            <WrapPanel>
              <Button Name="BtnMediaPickInstallImage" Content="Install-Image wählen" Height="30" MinWidth="160" Margin="0,0,10,8"/>
              <Button Name="BtnMediaClearInstallImage" Content="Install zurücksetzen" Height="30" MinWidth="150" Margin="0,0,10,8"/>
              <Button Name="BtnMediaPickBootImage" Content="boot.wim wählen" Height="30" MinWidth="140" Margin="0,0,10,8"/>
              <Button Name="BtnMediaClearBootImage" Content="Boot zurücksetzen" Height="30" MinWidth="140" Margin="0,0,10,8"/>
              <Button Name="BtnMediaBuildIso" Content="Neue ISO bauen" Height="30" MinWidth="150" Margin="0,0,0,8"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="16" CornerRadius="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,8" Text="2. Ein gemeinsames Install-Image bauen"/>
            <TextBlock Name="TxtMediaComposeSummary"
                       Foreground="#475569"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="Noch keine Quell-Dateien ausgewählt."/>

            <Border Background="#EEF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="12" CornerRadius="10" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6" Text="Build-Modus"/>
                <RadioButton Name="RbMediaBuildWim"
                             GroupName="MediaInstallBuildMode"
                             IsChecked="True"
                             Margin="0,0,0,4"
                             Content="install.wim bauen (empfohlen, deutlich schneller, Datei größer)"/>
                <RadioButton Name="RbMediaBuildEsd"
                             GroupName="MediaInstallBuildMode"
                             Content="install.esd bauen (kleiner, kann bei großen Images sehr lange dauern)"/>
              </StackPanel>
            </Border>

            <WrapPanel Margin="0,0,0,10">
              <Button Name="BtnMediaAddSourceImage" Content="WIM/ESD hinzufügen" Height="30" MinWidth="150" Margin="0,0,10,8"/>
              <Button Name="BtnMediaRemoveSourceImage" Content="Auswahl entfernen" Height="30" MinWidth="150" Margin="0,0,10,8"/>
              <Button Name="BtnMediaBuildInstallEsd" Content="Install-Image bauen" Height="30" MinWidth="150" Margin="0,0,10,8"/>
              <Button Name="BtnMediaCancelBuild" Content="Build abbrechen" Height="30" MinWidth="140" Margin="0,0,0,8" IsEnabled="False" Visibility="Collapsed"/>
            </WrapPanel>

            <ListView Name="LstMediaComposeItems" MinHeight="220" SelectionMode="Extended">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Datei" Width="220" DisplayMemberBinding="{Binding FileName}" />
                  <GridViewColumn Header="Index" Width="60" DisplayMemberBinding="{Binding Index}" />
                  <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                  <GridViewColumn Header="Description" Width="360" DisplayMemberBinding="{Binding Description}" />
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>
        </Border>

        <Border Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="16" CornerRadius="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontWeight="SemiBold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,8" Text="3. USB-Stick vorbereiten"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Foreground="#475569" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Kopiert eine vorbereitete Windows-Quelle auf einen USB-Zielordner. Sicherer erster Schritt: Es wird nichts formatiert und nichts gelöscht."/>

            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Quelle:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtMediaUsbSource" Margin="0,0,10,8" Text="-" TextWrapping="Wrap"/>
            <Button Grid.Row="2" Grid.Column="2" Name="BtnMediaPickUsbSource" Content="Quelle wählen" Height="28" MinWidth="130" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="USB-Ziel:"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtMediaUsbTarget" Margin="0,0,10,8" Text="-" TextWrapping="Wrap"/>
            <WrapPanel Grid.Row="3" Grid.Column="2" MaxWidth="320" Margin="0,0,0,4">
              <Button Name="BtnMediaPickUsbTarget" Content="USB wählen" Height="28" MinWidth="110" Margin="0,0,8,4"/>
              <Button Name="BtnMediaCheckUsb" Content="USB prüfen" Height="28" MinWidth="110" Margin="0,0,8,4"/>
              <Button Name="BtnMediaOpenUsbTarget" Content="Ziel öffnen" Height="28" MinWidth="110" Margin="0,0,8,4"/>
              <Button Name="BtnMediaResetUsb" Content="Reset" Height="28" MinWidth="90" Margin="0,0,8,4"/>
              <Button Name="BtnMediaCopyToUsb" Content="Auf USB kopieren" Height="28" MinWidth="140" Margin="0,0,0,4"/>
            </WrapPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                       Name="TxtMediaUsbSummary"
                       Foreground="#92400E"
                       TextWrapping="Wrap"
                       Text="Hinweis: Für UEFI-Boot muss der Stick passend vorbereitet sein. Das Tool kopiert hier nur Dateien."/>
            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                       Name="TxtMediaUsbWarnings"
                       Foreground="#B45309"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text=""/>
          </Grid>
        </Border>

        <Border Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="16" CornerRadius="14" Margin="0,12,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                       FontWeight="SemiBold"
                       FontSize="16"
                       Foreground="#0F172A"
                       Margin="0,0,0,10"
                       Text="Aktueller Build"/>

            <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,8" Text="Status:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtMediaCurrentStep" Margin="0,0,12,8" Text="Bereit" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Grid.Column="2" FontWeight="SemiBold" Margin="0,0,8,8" Text="Größe:"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Name="TxtMediaCurrentSize" Margin="0,0,0,8" Text="0 B"/>

            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,0" Text="Details:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtMediaCurrentDetail" Margin="0,0,12,0" Text="Noch kein Build gestartet." TextWrapping="Wrap"/>
            <TextBlock Grid.Row="2" Grid.Column="2" FontWeight="SemiBold" Margin="0,0,8,0" Text="Zeit:"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Name="TxtMediaElapsed" Text="00:00"/>
          </Grid>
        </Border>

        <ListBox Name="LstMediaBuildLog"
                 MinHeight="110"
                 Margin="0,8,0,0"
                 Background="White"
                 BorderBrush="#D5DEE6"
                 BorderThickness="1"
                 FontFamily="Consolas"
                 FontSize="12"/>

      </StackPanel>
    </ScrollViewer>

    <Border Name="BusyOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="9999"
            Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="Collapsed"
            IsHitTestVisible="True">
      <Grid HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="520">
        <Border Background="#FFFFFFFF" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Name="TxtBusyMessage"
                       Text="Bitte warten..."
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,10"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ProgressBar Name="PrgBusy"
                         Height="18"
                         Width="420"
                         IsIndeterminate="True" />
            <TextBlock Name="TxtBusyElapsed"
                       Text="Laufzeit: 00:00"
                       Foreground="#334155"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0"
                       TextAlignment="Center" />
            <TextBlock Name="TxtBusyDetail"
                       Text=""
                       Foreground="#475569"
                       Margin="0,8,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Name="TxtBusyDismLastLine"
                       Text=""
                       Foreground="#0F766E"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Name="TxtBusyHint"
                       Text=""
                       Foreground="#92400E"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <Button Name="BtnMediaCancelBuildOverlay"
                    Content="Build abbrechen"
                    Height="30"
                    MinWidth="150"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Page>
