<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Driver"
      Background="Transparent">

  <!--
    Kein äußerer ScrollViewer um die ListView.
    SelectionMode=Extended für Mehrfachauswahl (Strg/Shift). Reload ist entfernt, da automatisch aktualisiert wird.
  -->

  <Grid Margin="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="24"
               FontWeight="SemiBold"
               Foreground="#0F172A"
               Margin="0,0,0,16"
               Text="Driver" />

    <Border Grid.Row="1" Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="14" CornerRadius="14" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,12"
                   Text="Mounted Image auswählen" />

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Margin="0,0,10,0"
                     Text="MountDir:"/>

          <ComboBox Grid.Column="1"
                    Name="CmbDriverMount"
                    Height="28"
                    MinWidth="420"
                    Margin="0,0,10,0"/>

          <Button Grid.Column="2"
                  Name="BtnDriverRefreshMounts"
                  Content="Refresh Mounts"
                  Height="28"
                  MinWidth="130"
                  Margin="0,0,10,0"/>

          <Button Grid.Column="3"
                  Name="BtnDriverLoadDrivers"
                  Content="Treiber laden"
                  Height="28"
                  MinWidth="120"/>
        </Grid>

        <TextBlock Grid.Row="2"
                   Name="TxtDriverMountUsed"
                   Margin="0,10,0,0"
                   Foreground="#374151"
                   TextWrapping="Wrap"
                   Text="Mount: -" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="14" CornerRadius="14" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Name="BtnDriverAddDrivers"
                  Content="Treiber hinzufügen (Ordner)..."
                  Height="28"
                  MinWidth="210"
                  Margin="0,0,10,0"/>

          <Button Name="BtnDriverRemoveSelected"
                  Content="Treiber entfernen (Selected)"
                  Height="28"
                  MinWidth="210"
                  Margin="0,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
          <CheckBox Name="ChkDriverAll"
                    IsChecked="False"
                    VerticalAlignment="Center"
                    Margin="0,0,18,0"
                    Content="Alle Treiber (inkl. Inbox)"/>

          <CheckBox Name="ChkDriverRecurse"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    Margin="0,0,18,0"
                    Content="Recurse (Unterordner)"/>

          <CheckBox Name="ChkDriverForceUnsigned"
                    IsChecked="False"
                    VerticalAlignment="Center"
                    Content="ForceUnsigned (unsigniert)"/>
        </StackPanel>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Name="TxtDriverSelected"
                     Foreground="#374151"
                     TextWrapping="Wrap"
                     Text="Selected: -" />

          <TextBlock Grid.Column="1"
                     Name="TxtDriverCount"
                     Foreground="#374151"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0"
                     Text="Treiber: 0" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="14" CornerRadius="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,12"
                   Text="Treiber im Image" />

        <ListView Grid.Row="1"
                  Name="LstDrivers"
                  SelectionMode="Extended"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="PublishedName" Width="120" DisplayMemberBinding="{Binding PublishedName}" />
              <GridViewColumn Header="OriginalFileName" Width="220" DisplayMemberBinding="{Binding OriginalFileName}" />
              <GridViewColumn Header="Provider" Width="180" DisplayMemberBinding="{Binding ProviderName}" />
              <GridViewColumn Header="Class" Width="140" DisplayMemberBinding="{Binding ClassName}" />
              <GridViewColumn Header="Date" Width="100" DisplayMemberBinding="{Binding Date}" />
              <GridViewColumn Header="Version" Width="140" DisplayMemberBinding="{Binding Version}" />
              <GridViewColumn Header="Inbox" Width="70" DisplayMemberBinding="{Binding Inbox}" />
            </GridView>
          </ListView.View>
        </ListView>

      </Grid>
    </Border>

    <Border Name="BusyOverlay"
            Grid.RowSpan="4"
            Background="#80000000"
            Visibility="Collapsed">
      <Grid HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="520">
        <Border Background="#FFFFFFFF" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Name="TxtBusyMessage"
                       Text="Bitte warten..."
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,10"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ProgressBar Height="18"
                         IsIndeterminate="True" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

  </Grid>
</Page>
