<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="Transparent">
  <Grid Margin="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="24"
               FontWeight="SemiBold"
               Foreground="#0F172A"
               Margin="0,0,0,16"
               Text="Dashboard" />

    <!-- Aktionen -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <Button Name="BtnSelectIso" Width="160" Height="34" Margin="0,0,10,10" Content="ISO wählen"/>
      <Button Name="BtnMountIso" Width="160" Height="34" Margin="0,0,10,10" Content="ISO mounten"/>
      <Button Name="BtnAutoDetectIso" Width="160" Height="34" Margin="0,0,10,10" Content="AutoDetect ISO"/>
      <Button Name="BtnDismountIso" Width="160" Height="34" Margin="0,0,10,10" Content="ISO aushängen"/>

      <Button Name="BtnSelectImage" Width="160" Height="34" Margin="0,0,10,10" Content="WIM/ESD wählen"/>
    </WrapPanel>

    <!-- Status -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border Background="#ECFDF5" BorderBrush="#99F6E4" BorderThickness="1" Padding="14" CornerRadius="14" Margin="0,0,0,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="#0F172A"
                       Margin="0,0,0,12"
                       Text="Systemüberblick"/>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
              <Border Background="White" BorderBrush="#CCFBF1" BorderThickness="1" Padding="12" CornerRadius="12" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Foreground="#64748B" Text="Aktive Mounts"/>
                  <TextBlock Name="TxtDashActiveMounts" FontSize="22" FontWeight="SemiBold" Foreground="#0F766E" Text="-"/>
                  <TextBlock Name="TxtDashMountHealth" Foreground="#475569" TextWrapping="Wrap" Text="-"/>
                </StackPanel>
              </Border>

              <Border Background="White" BorderBrush="#CCFBF1" BorderThickness="1" Padding="12" CornerRadius="12" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Foreground="#64748B" Text="Letzter Job"/>
                  <TextBlock Name="TxtDashLastJob" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" Text="-"/>
                  <TextBlock Name="TxtDashLastJobDetail" Foreground="#475569" TextWrapping="Wrap" Text="-"/>
                </StackPanel>
              </Border>

              <Border Background="White" BorderBrush="#CCFBF1" BorderThickness="1" Padding="12" CornerRadius="12" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Foreground="#64748B" Text="Letzter Fehler"/>
                  <TextBlock Name="TxtDashLastError" FontWeight="SemiBold" Foreground="#991B1B" TextWrapping="Wrap" Text="-"/>
                  <TextBlock Name="TxtDashLastErrorDetail" Foreground="#475569" TextWrapping="Wrap" Text="-"/>
                </StackPanel>
              </Border>

              <Border Background="White" BorderBrush="#CCFBF1" BorderThickness="1" Padding="12" CornerRadius="12">
                <StackPanel>
                  <TextBlock Foreground="#64748B" Text="Tools"/>
                  <TextBlock Name="TxtDashDismStatus" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" Text="-"/>
                  <TextBlock Name="TxtDashAdkStatus" Foreground="#475569" TextWrapping="Wrap" Text="-"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Job-Verlauf:" Margin="0,0,0,8"/>
                <Button Name="BtnDashRefreshJobs"
                        Content="Aktualisieren"
                        Height="28"
                        Width="120"
                        HorizontalAlignment="Left"/>
              </StackPanel>

              <DataGrid Grid.Column="1"
                        Name="GridDashRecentJobs"
                        MinHeight="140"
                        MaxHeight="190"
                        Background="White"
                        BorderBrush="#CCFBF1"
                        BorderThickness="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="92"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="88"/>
                  <DataGridTextColumn Header="Aktion" Binding="{Binding Operation}" Width="*"/>
                  <DataGridTextColumn Header="Dauer" Binding="{Binding Duration}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>

              <Border Grid.Column="3"
                      Background="White"
                      BorderBrush="#CCFBF1"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="10">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"
                               Text="Job-Details"/>
                    <WrapPanel Grid.Column="1">
                      <Button Name="BtnDashCopyJobDetails"
                              Content="Kopieren"
                              Height="26"
                              MinWidth="84"
                              Margin="0,0,6,0"/>
                      <Button Name="BtnDashOpenHistory"
                              Content="History"
                              Height="26"
                              MinWidth="76"
                              Margin="0,0,6,0"/>
                      <Button Name="BtnDashOpenDismLog"
                              Content="DISM-Log"
                              Height="26"
                              MinWidth="82"/>
                    </WrapPanel>
                  </Grid>
                  <TextBlock Name="TxtDashJobDetails"
                             Foreground="#475569"
                             Text="Job auswählen, um Details zu sehen."
                             TextWrapping="Wrap"/>
                  <TextBlock Name="TxtDashJobError"
                             Foreground="#991B1B"
                             Margin="0,8,0,0"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <!-- ISO Bereich -->
        <Border Background="#F7FAFC" BorderBrush="#D5DEE6" BorderThickness="1" Padding="14" CornerRadius="14" Margin="0,0,0,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,12"
                       Text="ISO Status" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,6" FontWeight="SemiBold" Text="ISO Pfad:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap" Name="TxtIsoPath" Text="-"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,6" FontWeight="SemiBold" Text="ISO Root:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap" Name="TxtIsoRoot" Text="-"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,6" FontWeight="SemiBold" Text="Boot (boot.wim):"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap" Name="TxtBootPath" Text="-"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,0" FontWeight="SemiBold" Text="Install (aus ISO):"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,0" TextWrapping="Wrap" Name="TxtIsoInstallPath" Text="-"/>
          </Grid>
        </Border>

        <!-- Standalone WIM Bereich (standardmäßig verborgen) -->
        <Border Name="PanelStandalone"
                Background="#F7FAFC"
                BorderBrush="#D5DEE6"
                BorderThickness="1"
                Padding="14"
                CornerRadius="14"
                Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,12"
                       Text="Standalone WIM/ESD (manuell gewählt)" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" FontWeight="SemiBold" Text="Pfad:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" TextWrapping="Wrap" Name="TxtStandaloneImagePath" Text="-"/>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</Page>
