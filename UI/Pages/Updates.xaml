<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Updates"
      Background="Transparent">

  <Grid Margin="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Titel -->
    <TextBlock Grid.Row="0"
               Text="Updates"
               FontSize="24"
               FontWeight="SemiBold"
               Foreground="#0F172A"
               Margin="0,0,0,16"/>

    <!-- Kopfbereich -->
    <Border Grid.Row="2"
            BorderBrush="#D5DEE6"
            BorderThickness="1"
            Background="#F7FAFC"
            CornerRadius="14"
            Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  Background="White"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel>
              <TextBlock Text="Quelle"
                         FontWeight="SemiBold"
                         Foreground="#334155"
                         Margin="0,0,0,6"/>
              <WrapPanel Orientation="Horizontal">
                <Button Name="BtnUpdatesRefresh"
                        Content="Refresh"
                        Height="30"
                        MinWidth="100"
                        Padding="12,0"
                        Margin="0,0,8,0"/>
                <Button Name="BtnCatalogSearch"
                        Content="Catalog suchen"
                        Height="30"
                        MinWidth="120"
                        Padding="12,0"
                        Margin="0,0,8,0"/>
                <Button Name="BtnAddLocalUpdate"
                        Content="MSU/CAB wählen"
                        Height="30"
                        MinWidth="120"
                        Padding="12,0"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  Background="White"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel>
              <TextBlock Text="Aktionen"
                         FontWeight="SemiBold"
                         Foreground="#334155"
                         Margin="0,0,0,6"/>
              <WrapPanel Orientation="Horizontal">
                <Button Name="BtnCatalogDownload"
                        Content="Download"
                        Height="30"
                        MinWidth="100"
                        Padding="12,0"
                        IsEnabled="False"
                        Margin="0,0,8,0"/>
                <Button Name="BtnCatalogIntegrate"
                        Content="In Mount"
                        Height="30"
                        MinWidth="115"
                        Padding="12,0"
                        IsEnabled="False"
                        Margin="0,0,8,0"/>
                <Button Name="BtnCatalogIntegrateAll"
                        Content="In alle Mounts"
                        Height="30"
                        MinWidth="130"
                        Padding="12,0"
                        IsEnabled="False"
                        Margin="0,0,8,0"/>
                <Button Name="BtnCatalogPreflight"
                        Content="Batch prüfen"
                        Height="30"
                        MinWidth="120"
                        Padding="12,0"
                        IsEnabled="False"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="4"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  Background="White"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel>
              <TextBlock Text="Ansicht &amp; Suche"
                         FontWeight="SemiBold"
                         Foreground="#334155"
                         Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Ansicht:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <ComboBox Grid.Column="2"
                          Name="CmbUpdatesFilterMode"
                          Height="28"
                          MinWidth="210"
                          SelectedIndex="0">
                  <ComboBoxItem Name="CmbUpdatesModeRecommended" Content="Nur empfohlene Treffer"/>
                  <ComboBoxItem Name="CmbUpdatesModeAll" Content="Alle Treffer"/>
                  <ComboBoxItem Name="CmbUpdatesModePackages" Content="Nur echte Updates"/>
                </ComboBox>
                <TextBlock Grid.Column="4"
                           Text="Suche:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Column="6"
                         Name="TxtUpdatesFilterText"
                         Height="28"
                         MinWidth="220"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Mount -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="Mount:"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"/>

          <ComboBox Grid.Column="2"
                    Name="CmbUpdatesMounts"
                    Height="28"
                    MinWidth="430"
                    IsEnabled="False"/>

          <CheckBox Grid.Column="4"
                    Name="ChkUpdatesAutoCatalog"
                    VerticalAlignment="Center"
                    IsChecked="True"
                    Content="Catalog bei Mount-Wechsel automatisch laden"/>
        </Grid>

        <!-- Kompakte Statuszeile -->
        <Border Grid.Row="4"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
              Background="White"
              CornerRadius="10"
              Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="4"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="1.1*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="Image:"
                         FontWeight="SemiBold"
                         Margin="0,0,8,0"/>

              <TextBlock Grid.Column="1"
                         Name="TxtUpdatesImageFile"
                         Text="-"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Margin="0,0,12,0"/>

              <TextBlock Grid.Column="2"
                         Text="Edition:"
                         FontWeight="SemiBold"
                         Margin="0,0,8,0"/>

              <TextBlock Grid.Column="3"
                         Name="TxtUpdatesEdition"
                         Text="-"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Margin="0,0,12,0"/>

              <TextBlock Grid.Column="4"
                         Text="LCU:"
                         FontWeight="SemiBold"
                         Margin="0,0,8,0"/>

              <TextBlock Grid.Column="5"
                         Name="TxtRecommendedLCU"
                         Text="-"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="1.1*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="Status:"
                         FontWeight="SemiBold"
                         Margin="0,0,8,0"/>

              <TextBlock Grid.Column="1"
                         Name="TxtUpdatesStatus"
                         Text="-"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Margin="0,0,12,0"/>

              <TextBlock Grid.Column="2"
                         Text="Treffer:"
                         FontWeight="SemiBold"
                         Margin="0,0,8,0"/>

              <TextBlock Grid.Column="3"
                         Name="TxtUpdatesMountHint"
                         Text="Mounts: 0 | Auswahl: -"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Margin="0,0,12,0"/>

              <TextBlock Grid.Column="4"
                         Text="Info:"
                         FontWeight="SemiBold"
                         Margin="0,0,8,0"/>

              <TextBlock Grid.Column="5"
                         Name="TxtRecommendationSummary"
                         Text="Noch keine Catalog-Suche ausgeführt."
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Grid>

            <TextBlock Grid.Row="4"
                       Name="TxtUpdatesBatchPlan"
                       Text="Batch: Mounts werden geladen."
                       Foreground="#475569"
                       TextWrapping="Wrap"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Hauptbereich 50/50 -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Installierte Pakete links -->
      <Border Grid.Column="0"
              BorderBrush="#D5DEE6"
              BorderThickness="1"
              Background="White"
              CornerRadius="14"
              Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Installierte Pakete"
                       FontSize="15"
                       FontWeight="SemiBold"/>

            <Button Grid.Column="1"
                    Name="BtnUpdatesExportPackages"
                    Content="CSV exportieren"
                    Height="28"
                    MinWidth="140"
                    Margin="8,0,0,0"/>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Pakete:"
                       FontWeight="SemiBold"/>

            <ComboBox Grid.Column="2"
                      Name="CmbUpdatesPackagesMode"
                      Height="28"
                      SelectedIndex="0">
              <ComboBoxItem Content="Nur wichtige Pakete"/>
              <ComboBoxItem Content="Nur Pakete mit KB"/>
              <ComboBoxItem Content="Alle Pakete"/>
            </ComboBox>

            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Text="Filter:"
                       FontWeight="SemiBold"/>

            <TextBox Grid.Column="6"
                     Name="TxtUpdatesPackagesFilter"
                     Height="28"/>
          </Grid>

          <DataGrid Grid.Row="4"
                    Name="GridUpdatesPackages"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    RowHeaderWidth="0"
                    AlternatingRowBackground="#FAFAFA">
            <DataGrid.Columns>
              <DataGridTextColumn Header="KB" Binding="{Binding KB}" Width="90"/>
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
              <DataGridTextColumn Header="Release Type" Binding="{Binding ReleaseType}" Width="120"/>
              <DataGridTextColumn Header="Install Time" Binding="{Binding InstallTime}" Width="135"/>
              <DataGridTextColumn Header="Package" Binding="{Binding PackageIdentity}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="6"
                     Name="TxtUpdatesPackagesCount"
                     Foreground="#6B7280"
                     Text="Pakete: 0"/>
        </Grid>
      </Border>

      <!-- Catalog rechts -->
      <Border Grid.Column="2"
              BorderBrush="#D5DEE6"
              BorderThickness="1"
              Background="White"
              CornerRadius="14"
              Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Catalog-Treffer"
                       FontSize="15"
                       FontWeight="SemiBold"/>

            <Button Grid.Column="1"
                    Name="BtnUpdatesExportCatalog"
                    Content="CSV exportieren"
                    Height="28"
                    MinWidth="140"
                    Margin="8,0,0,0"/>
          </Grid>

          <DataGrid Grid.Row="2"
                    Name="GridCatalogResults"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    RowHeaderWidth="0"
                    AlternatingRowBackground="#FAFAFA">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Name="MiCatalogDownload" Header="Download"/>
                <MenuItem Name="MiCatalogIntegrate" Header="In ausgewählten Mount integrieren"/>
                <MenuItem Name="MiCatalogIntegrateAll" Header="In alle passenden Mounts integrieren"/>
                <Separator/>
                <MenuItem Name="MiCatalogPreflight" Header="Batch vorher prüfen"/>
                <MenuItem Name="MiCatalogAddLocal" Header="Lokale MSU/CAB hinzufügen"/>
                <Separator/>
                <MenuItem Name="MiCatalogCopyTitle" Header="Titel kopieren"/>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="KB" Binding="{Binding KB}" Width="95"/>
              <DataGridTextColumn Header="Typ" Binding="{Binding Kind}" Width="90"/>
              <DataGridTextColumn Header="Datum" Binding="{Binding LastUpdated}" Width="105"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/>
              <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="4"
                     Name="TxtCatalogResultsCount"
                     Foreground="#6B7280"
                     Text="Treffer: 0 | Lokal: 0"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Untere Detailzeile ohne Hinweis -->
    <Border Grid.Row="6"
            BorderBrush="#D5DEE6"
            BorderThickness="1"
            Background="#F7FAFC"
            CornerRadius="14"
            Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="2.4*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Treffer-Details"
                     FontWeight="SemiBold"/>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="KB:" Margin="0,0,8,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtSelectedCatalogKB" Text="-" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Typ:" Margin="0,0,8,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtSelectedCatalogType" Text="-" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Datum:" Margin="0,0,8,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtSelectedCatalogDate" Text="-" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Version:" Margin="0,0,8,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtSelectedCatalogVersion" Text="-" />
          </Grid>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Titel"
                     FontWeight="SemiBold"/>

          <TextBlock Grid.Row="2"
                     Name="TxtSelectedCatalogTitle"
                     Text="Noch kein Catalog-Treffer ausgewählt."
                     TextWrapping="Wrap"/>
        </Grid>
      </Grid>
    </Border>

    <!-- Versteckte Felder für Controller-Kompatibilität -->
    <StackPanel Visibility="Collapsed">
      <TextBlock Name="TxtUpdatesReadWrite" Text="-" />
      <TextBlock Name="TxtUpdatesCurrentLCU" Text="-" />
      <TextBlock Name="TxtUpdatesCurrentSSU" Text="-" />
      <TextBlock Name="TxtUpdatesCurrentDotNet" Text="-" />
      <TextBlock Name="TxtUpdatesInstalledKbCount" Text="0" />
      <TextBlock Name="TxtRecommendedSSU" Text="-" />
      <TextBlock Name="TxtRecommendedDotNet" Text="-" />
      <TextBlock Name="TxtUpdatesFilterHint" Text="-" />
      <TextBlock Name="TxtUpdatesFooterHint" Text="-" />
    </StackPanel>

    <!-- Busy Overlay -->
    <Border Name="BusyOverlay"
            Grid.RowSpan="7"
            Background="#66FFFFFF"
            Visibility="Collapsed">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="18"
              Background="White"
              BorderBrush="#CBD5E1"
              BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Bitte warten..."
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
          <ProgressBar IsIndeterminate="True"
                       Height="14"
                       Width="260"/>
          <TextBlock Name="TxtBusyMessage"
                     Margin="0,8,0,0"
                     Text="Bitte warten..."
                     TextWrapping="Wrap"/>
          <TextBlock Name="TxtBusyElapsed"
                     Text="Laufzeit: 00:00"
                     Foreground="#334155"
                     FontWeight="SemiBold"
                     Margin="0,10,0,0"/>
          <TextBlock Name="TxtBusyDetail"
                     Text=""
                     Foreground="#475569"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"/>
          <TextBlock Name="TxtBusyDismLastLine"
                     Text=""
                     Foreground="#0F766E"
                     FontSize="11"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"/>
          <TextBlock Name="TxtBusyHint"
                     Text=""
                     Foreground="#92400E"
                     FontSize="11"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Page>
